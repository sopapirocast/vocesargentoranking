# Preencha estas variáveis ao conectar um banco "Upstash for Redis" ao
# projeto (Vercel Dashboard → Storage → Marketplace → Upstash). Em produção
# a própria Vercel injeta essas variáveis automaticamente nas Functions
# (nomes herdados do antigo Vercel KV). Localmente, copie este arquivo para
# ".env" se quiser testar contra o Redis real; sem elas, o app usa
# data/rankings.json automaticamente.

KV_REST_API_URL=
KV_REST_API_TOKEN=

# Senha do painel administrativo (/admin). Obrigatória para usar o painel —
# sem ela as rotas /api/admin/* ficam bloqueadas.
ADMIN_PASSWORD=
